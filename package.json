{
  "name": "maze-of-galious-ts",
  "private": true,
  "version": "0.1.0",
  "description": "TypeScript port of the Brain Games remake of The Maze of Galious",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src tests tools",
    "lint": "prettier --check src tests tools && tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
